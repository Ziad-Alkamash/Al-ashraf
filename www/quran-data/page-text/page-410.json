{"code":200,"status":"OK","data":{"number":410,"ayahs":[{"number":3460,"text":"وَلَئِنْ أَرْسَلْنَا رِيحًۭا فَرَأَوْهُ مُصْفَرًّۭا لَّظَلُّوا۟ مِنۢ بَعْدِهِۦ يَكْفُرُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":51,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3461,"text":"فَإِنَّكَ لَا تُسْمِعُ ٱلْمَوْتَىٰ وَلَا تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوْا۟ مُدْبِرِينَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":52,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3462,"text":"وَمَآ أَنتَ بِهَٰدِ ٱلْعُمْىِ عَن ضَلَٰلَتِهِمْ ۖ إِن تُسْمِعُ إِلَّا مَن يُؤْمِنُ بِـَٔايَٰتِنَا فَهُم مُّسْلِمُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":53,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3463,"text":"۞ ٱللَّهُ ٱلَّذِى خَلَقَكُم مِّن ضَعْفٍۢ ثُمَّ جَعَلَ مِنۢ بَعْدِ ضَعْفٍۢ قُوَّةًۭ ثُمَّ جَعَلَ مِنۢ بَعْدِ قُوَّةٍۢ ضَعْفًۭا وَشَيْبَةًۭ ۚ يَخْلُقُ مَا يَشَآءُ ۖ وَهُوَ ٱلْعَلِيمُ ٱلْقَدِيرُ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":54,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3464,"text":"وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يُقْسِمُ ٱلْمُجْرِمُونَ مَا لَبِثُوا۟ غَيْرَ سَاعَةٍۢ ۚ كَذَٰلِكَ كَانُوا۟ يُؤْفَكُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":55,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3465,"text":"وَقَالَ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ وَٱلْإِيمَٰنَ لَقَدْ لَبِثْتُمْ فِى كِتَٰبِ ٱللَّهِ إِلَىٰ يَوْمِ ٱلْبَعْثِ ۖ فَهَٰذَا يَوْمُ ٱلْبَعْثِ وَلَٰكِنَّكُمْ كُنتُمْ لَا تَعْلَمُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":56,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3466,"text":"فَيَوْمَئِذٍۢ لَّا يَنفَعُ ٱلَّذِينَ ظَلَمُوا۟ مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَبُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":57,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3467,"text":"وَلَقَدْ ضَرَبْنَا لِلنَّاسِ فِى هَٰذَا ٱلْقُرْءَانِ مِن كُلِّ مَثَلٍۢ ۚ وَلَئِن جِئْتَهُم بِـَٔايَةٍۢ لَّيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ أَنتُمْ إِلَّا مُبْطِلُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":58,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3468,"text":"كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلَّذِينَ لَا يَعْلَمُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":59,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3469,"text":"فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّۭ ۖ وَلَا يَسْتَخِفَّنَّكَ ٱلَّذِينَ لَا يُوقِنُونَ","surah":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Ar-Room","englishNameTranslation":"The Romans","numberOfAyahs":60,"revelationType":"Meccan"},"numberInSurah":60,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false}],"s