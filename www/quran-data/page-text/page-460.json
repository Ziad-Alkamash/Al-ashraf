{"code":200,"status":"OK","data":{"number":460,"ayahs":[{"number":4069,"text":"قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَعْبُدَ ٱللَّهَ مُخْلِصًۭا لَّهُ ٱلدِّينَ","surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":11,"juz":23,"manzil":6,"page":460,"ruku":397,"hizbQuarter":184,"sajda":false},{"number":4070,"text":"وَأُمِرْتُ لِأَنْ أَكُونَ أَوَّلَ ٱلْمُسْلِمِينَ","surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":12,"juz":23,"manzil":6,"page":460,"ruku":397,"hizbQuarter":184,"sajda":false},{"number":4071,"text":"قُلْ إِنِّىٓ أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَظِيمٍۢ","surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":13,"juz":23,"manzil":6,"page":460,"ruku":397,"hizbQuarter":184,"sajda":false},{"number":4072,"text":"قُلِ ٱللَّهَ أَعْبُدُ مُخْلِصًۭا لَّهُۥ دِينِى","surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":14,"juz":23,"manzil":6,"page":460,"ruku":397,"hizbQuarter":184,"sajda":false},{"number":4073,"text":"فَٱعْبُدُوا۟ مَا شِئْتُم مِّن دُونِهِۦ ۗ قُلْ إِنَّ ٱلْخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ ٱلْقِيَٰمَةِ ۗ أَلَا ذَٰلِكَ هُوَ ٱلْخُسْرَانُ ٱلْمُبِينُ","surah":{"number":39,"name":"سُورَةُ الزُّمَرِ","englishName":"Az-Zumar","englishNameTranslation":"The Groups","numberOfAyahs":75,"revelationType":"Meccan"},"numberInSurah":15,"juz":23,"manzil":6,"page":460,"ruku":397,"hizbQuarter":184,"sajda":false},{"number":4074,"text":"لَهُم مِّن فَوْقِهِمْ ظُلَلٌۭ مِّنَ ٱلنَّارِ وَمِن تَحْتِهِمْ ظُلَلٌۭ ۚ ذَٰلِكَ يُخَوِّفُ ٱللَّهُ بِهِۦ عِبَادَهُۥ ۚ يَٰعِبَادِ فَٱتَّقُ