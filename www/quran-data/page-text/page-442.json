{"code":200,"status":"OK","data":{"number":442,"ayahs":[{"number":3733,"text":"۞ وَمَآ أَنزَلْنَا عَلَىٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندٍۢ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTranslation":"Yaseen","numberOfAyahs":83,"revelationType":"Meccan"},"numberInSurah":28,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3734,"text":"إِن كَانَتْ إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ فَإِذَا هُمْ خَٰمِدُونَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTranslation":"Yaseen","numberOfAyahs":83,"revelationType":"Meccan"},"numberInSurah":29,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3735,"text":"يَٰحَسْرَةً عَلَى ٱلْعِبَادِ ۚ مَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTranslation":"Yaseen","numberOfAyahs":83,"revelationType":"Meccan"},"numberInSurah":30,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3736,"text":"أَلَمْ يَرَوْا۟ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTranslation":"Yaseen","numberOfAyahs":83,"revelationType":"Meccan"},"numberInSurah":31,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3737,"text":"وَإِن كُلٌّۭ لَّمَّا جَمِيعٌۭ لَّدَيْنَا مُحْضَرُونَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTranslation":"Yaseen","numberOfAyahs":83,"revelationType":"Meccan"},"numberInSurah":32,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3738,"text":"وَءَايَةٌۭ لَّهُمُ ٱلْأَرْضُ ٱلْمَيْتَةُ أَحْيَيْنَٰهَا وَأَخْرَجْنَا مِنْهَا حَبًّۭا فَمِنْهُ يَأْكُلُونَ","surah":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yaseen","englishNameTran