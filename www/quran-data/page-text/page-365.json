{"code":200,"status":"OK","data":{"number":365,"ayahs":[{"number":2911,"text":"وَمَآ أَرْسَلْنَٰكَ إِلَّا مُبَشِّرًۭا وَنَذِيرًۭا","surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":56,"juz":19,"manzil":4,"page":365,"ruku":314,"hizbQuarter":146,"sajda":false},{"number":2912,"text":"قُلْ مَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِلَّا مَن شَآءَ أَن يَتَّخِذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا","surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":57,"juz":19,"manzil":4,"page":365,"ruku":314,"hizbQuarter":146,"sajda":false},{"number":2913,"text":"وَتَوَكَّلْ عَلَى ٱلْحَىِّ ٱلَّذِى لَا يَمُوتُ وَسَبِّحْ بِحَمْدِهِۦ ۚ وَكَفَىٰ بِهِۦ بِذُنُوبِ عِبَادِهِۦ خَبِيرًا","surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":58,"juz":19,"manzil":4,"page":365,"ruku":314,"hizbQuarter":146,"sajda":false},{"number":2914,"text":"ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍۢ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۚ ٱلرَّحْمَٰنُ فَسْـَٔلْ بِهِۦ خَبِيرًۭا","surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":59,"juz":19,"manzil":4,"page":365,"ruku":314,"hizbQuarter":146,"sajda":false},{"number":2915,"text":"وَإِذَا قِيلَ لَهُمُ ٱسْجُدُوا۟ لِلرَّحْمَٰنِ قَالُوا۟ وَمَا ٱلرَّحْمَٰنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا وَزَادَهُمْ نُفُورًۭا ۩","surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":60,"juz":19,"manzil":4,"page":365,"ruku":314,"hizbQuarter":1