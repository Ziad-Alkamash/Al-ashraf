{"code":200,"status":"OK","data":{"number":381,"ayahs":[{"number":3204,"text":"وَلَقَدْ أَرْسَلْنَآ إِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ فَإِذَا هُمْ فَرِيقَانِ يَخْتَصِمُونَ","surah":{"number":27,"name":"سُورَةُ النَّمۡلِ","englishName":"An-Naml","englishNameTranslation":"The Ant","numberOfAyahs":93,"revelationType":"Meccan"},"numberInSurah":45,"juz":19,"manzil":5,"page":381,"ruku":330,"hizbQuarter":152,"sajda":false},{"number":3205,"text":"قَالَ يَٰقَوْمِ لِمَ تَسْتَعْجِلُونَ بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ ۖ لَوْلَا تَسْتَغْفِرُونَ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ","surah":{"number":27,"name":"سُورَةُ النَّمۡلِ","englishName":"An-Naml","englishNameTranslation":"The Ant","numberOfAyahs":93,"revelationType":"Meccan"},"numberInSurah":46,"juz":19,"manzil":5,"page":381,"ruku":330,"hizbQuarter":152,"sajda":false},{"number":3206,"text":"قَالُوا۟ ٱطَّيَّرْنَا بِكَ وَبِمَن مَّعَكَ ۚ قَالَ طَٰٓئِرُكُمْ عِندَ ٱللَّهِ ۖ بَلْ أَنتُمْ قَوْمٌۭ تُفْتَنُونَ","surah":{"number":27,"name":"سُورَةُ النَّمۡلِ","englishName":"An-Naml","englishNameTranslation":"The Ant","numberOfAyahs":93,"revelationType":"Meccan"},"numberInSurah":47,"juz":19,"manzil":5,"page":381,"ruku":330,"hizbQuarter":152,"sajda":false},{"number":3207,"text":"وَكَانَ فِى ٱلْمَدِينَةِ تِسْعَةُ رَهْطٍۢ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ","surah":{"number":27,"name":"سُورَةُ النَّمۡلِ","englishName":"An-Naml","englishNameTranslation":"The Ant","numberOfAyahs":93,"revelationType":"Meccan"},"numberInSurah":48,"juz":19,"manzil":5,"page":381,"ruku":330,"hizbQuarter":152,"sajda":false},{"number":3208,"text":"قَالُوا۟ تَقَاسَمُوا۟ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدْنَا مَهْلِكَ أَهْلِهِۦ وَإِنَّا لَصَٰدِقُونَ","surah":{"number":27,"name":"سُورَةُ النَّمۡلِ","englishName":"An-Naml","englishNameTranslation":"The Ant","numberOfAyahs":93,"revelationType":"Meccan"},"numberInSurah":49,"juz":19,"manzil":5,"page":381,"ruku":330,"hizbQuarter":152,"sajda":f