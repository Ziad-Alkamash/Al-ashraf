{"code":200,"status":"OK","data":{"number":310,"ayahs":[{"number":2315,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا فَٱعْبُدْهُ وَٱصْطَبِرْ لِعِبَٰدَتِهِۦ ۚ هَلْ تَعْلَمُ لَهُۥ سَمِيًّۭا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","englishNameTranslation":"Mary","numberOfAyahs":98,"revelationType":"Meccan"},"numberInSurah":65,"juz":16,"manzil":4,"page":310,"ruku":267,"hizbQuarter":124,"sajda":false},{"number":2316,"text":"وَيَقُولُ ٱلْإِنسَٰنُ أَءِذَا مَا مِتُّ لَسَوْفَ أُخْرَجُ حَيًّا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","englishNameTranslation":"Mary","numberOfAyahs":98,"revelationType":"Meccan"},"numberInSurah":66,"juz":16,"manzil":4,"page":310,"ruku":268,"hizbQuarter":124,"sajda":false},{"number":2317,"text":"أَوَلَا يَذْكُرُ ٱلْإِنسَٰنُ أَنَّا خَلَقْنَٰهُ مِن قَبْلُ وَلَمْ يَكُ شَيْـًۭٔا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","englishNameTranslation":"Mary","numberOfAyahs":98,"revelationType":"Meccan"},"numberInSurah":67,"juz":16,"manzil":4,"page":310,"ruku":268,"hizbQuarter":124,"sajda":false},{"number":2318,"text":"فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَٱلشَّيَٰطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ جَهَنَّمَ جِثِيًّۭا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","englishNameTranslation":"Mary","numberOfAyahs":98,"revelationType":"Meccan"},"numberInSurah":68,"juz":16,"manzil":4,"page":310,"ruku":268,"hizbQuarter":124,"sajda":false},{"number":2319,"text":"ثُمَّ لَنَنزِعَنَّ مِن كُلِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى ٱلرَّحْمَٰنِ عِتِيًّۭا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","englishNameTranslation":"Mary","numberOfAyahs":98,"revelationType":"Meccan"},"numberInSurah":69,"juz":16,"manzil":4,"page":310,"ruku":268,"hizbQuarter":124,"sajda":false},{"number":2320,"text":"ثُمَّ لَنَحْنُ أَعْلَمُ بِٱلَّذِينَ هُمْ أَوْلَىٰ بِهَا صِلِيًّۭا","surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam","engl