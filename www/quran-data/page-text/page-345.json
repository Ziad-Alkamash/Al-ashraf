{"code":200,"status":"OK","data":{"number":345,"ayahs":[{"number":2716,"text":"مَا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ","surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon","englishNameTranslation":"The Believers","numberOfAyahs":118,"revelationType":"Meccan"},"numberInSurah":43,"juz":18,"manzil":4,"page":345,"ruku":297,"hizbQuarter":138,"sajda":false},{"number":2717,"text":"ثُمَّ أَرْسَلْنَا رُسُلَنَا تَتْرَا ۖ كُلَّ مَا جَآءَ أُمَّةًۭ رَّسُولُهَا كَذَّبُوهُ ۚ فَأَتْبَعْنَا بَعْضَهُم بَعْضًۭا وَجَعَلْنَٰهُمْ أَحَادِيثَ ۚ فَبُعْدًۭا لِّقَوْمٍۢ لَّا يُؤْمِنُونَ","surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon","englishNameTranslation":"The Believers","numberOfAyahs":118,"revelationType":"Meccan"},"numberInSurah":44,"juz":18,"manzil":4,"page":345,"ruku":297,"hizbQuarter":138,"sajda":false},{"number":2718,"text":"ثُمَّ أَرْسَلْنَا مُوسَىٰ وَأَخَاهُ هَٰرُونَ بِـَٔايَٰتِنَا وَسُلْطَٰنٍۢ مُّبِينٍ","surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon","englishNameTranslation":"The Believers","numberOfAyahs":118,"revelationType":"Meccan"},"numberInSurah":45,"juz":18,"manzil":4,"page":345,"ruku":297,"hizbQuarter":138,"sajda":false},{"number":2719,"text":"إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا عَالِينَ","surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon","englishNameTranslation":"The Believers","numberOfAyahs":118,"revelationType":"Meccan"},"numberInSurah":46,"juz":18,"manzil":4,"page":345,"ruku":297,"hizbQuarter":138,"sajda":false},{"number":2720,"text":"فَقَالُوٓا۟ أَنُؤْمِنُ لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُمَا لَنَا عَٰبِدُونَ","surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon","englishNameTranslation":"The Believers","numberOfAyahs":118,"revelationType":"Meccan"},"numberInSurah":47,"juz":18,"manzil":4,"page":345,"ruku":297,"hizbQuarter":138,"sajda":false},{"number":2721,"text":"فَكَذّ