{"code":200,"status":"OK","data":{"number":287,"ayahs":[{"number":2079,"text":"۞ قُلْ كُونُوا۟ حِجَارَةً أَوْ حَدِيدًا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":50,"juz":15,"manzil":4,"page":287,"ruku":244,"hizbQuarter":115,"sajda":false},{"number":2080,"text":"أَوْ خَلْقًۭا مِّمَّا يَكْبُرُ فِى صُدُورِكُمْ ۚ فَسَيَقُولُونَ مَن يُعِيدُنَا ۖ قُلِ ٱلَّذِى فَطَرَكُمْ أَوَّلَ مَرَّةٍۢ ۚ فَسَيُنْغِضُونَ إِلَيْكَ رُءُوسَهُمْ وَيَقُولُونَ مَتَىٰ هُوَ ۖ قُلْ عَسَىٰٓ أَن يَكُونَ قَرِيبًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":51,"juz":15,"manzil":4,"page":287,"ruku":244,"hizbQuarter":115,"sajda":false},{"number":2081,"text":"يَوْمَ يَدْعُوكُمْ فَتَسْتَجِيبُونَ بِحَمْدِهِۦ وَتَظُنُّونَ إِن لَّبِثْتُمْ إِلَّا قَلِيلًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":52,"juz":15,"manzil":4,"page":287,"ruku":244,"hizbQuarter":115,"sajda":false},{"number":2082,"text":"وَقُل لِّعِبَادِى يَقُولُوا۟ ٱلَّتِى هِىَ أَحْسَنُ ۚ إِنَّ ٱلشَّيْطَٰنَ يَنزَغُ بَيْنَهُمْ ۚ إِنَّ ٱلشَّيْطَٰنَ كَانَ لِلْإِنسَٰنِ عَدُوًّۭا مُّبِينًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":53,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false},{"number":2083,"text":"رَّبُّكُمْ أَعْلَمُ بِكُمْ ۖ إِن يَشَأْ يَرْحَمْكُمْ أَوْ إِن يَشَأْ يُعَذِّبْكُمْ ۚ وَمَآ أَرْسَلْنَٰكَ عَلَيْهِمْ وَكِيلًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":54,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false},{"number":2084,"text":"وَرَبُّكَ أَعْلَمُ بِمَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۗ وَلَقَدْ فَضَّلْنَا بَعْضَ ٱلنَّبِيِّۦنَ عَلَىٰ بَعْضٍۢ ۖ وَءَاتَيْنَا دَاوُۥدَ زَبُورًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":55,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false},{"number":2085,"text":"قُلِ ٱدْعُوا۟ ٱلَّذِينَ زَعَمْتُم مِّن دُونِهِۦ فَلَا يَمْلِكُونَ كَشْفَ ٱلضُّرِّ عَنكُمْ وَلَا تَحْوِيلًا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":56,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false},{"number":2086,"text":"أُو۟لَٰٓئِكَ ٱلَّذِينَ يَدْعُونَ يَبْتَغُونَ إِلَىٰ رَبِّهِمُ ٱلْوَسِيلَةَ أَيُّهُمْ أَقْرَبُ وَيَرْجُونَ رَحْمَتَهُۥ وَيَخَافُونَ عَذَابَهُۥٓ ۚ إِنَّ عَذَابَ رَبِّكَ كَانَ مَحْذُورًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":57,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false},{"number":2087,"text":"وَإِن مِّن قَرْيَةٍ إِلَّا نَحْنُ مُهْلِكُوهَا قَبْلَ يَوْمِ ٱلْقِيَٰمَةِ أَوْ مُعَذِّبُوهَا عَذَابًۭا شَدِيدًۭا ۚ كَانَ ذَٰلِكَ فِى ٱلْكِتَٰبِ مَسْطُورًۭا","surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":58,"juz":15,"manzil":4,"page":287,"ruku":245,"hizbQuarter":115,"sajda":false}],"surahs":{"17":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,