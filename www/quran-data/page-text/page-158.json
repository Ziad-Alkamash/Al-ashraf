{"code":200,"status":"OK","data":{"number":158,"ayahs":[{"number":1012,"text":"وَٱلْبَلَدُ ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ بِإِذْنِ رَبِّهِۦ ۖ وَٱلَّذِى خَبُثَ لَا يَخْرُجُ إِلَّا نَكِدًۭا ۚ كَذَٰلِكَ نُصَرِّفُ ٱلْءَايَٰتِ لِقَوْمٍۢ يَشْكُرُونَ","surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf","englishNameTranslation":"The Heights","numberOfAyahs":206,"revelationType":"Meccan"},"numberInSurah":58,"juz":8,"manzil":2,"page":158,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1013,"text":"لَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦ فَقَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓ إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍۢ","surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf","englishNameTranslation":"The Heights","numberOfAyahs":206,"revelationType":"Meccan"},"numberInSurah":59,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1014,"text":"قَالَ ٱلْمَلَأُ مِن قَوْمِهِۦٓ إِنَّا لَنَرَىٰكَ فِى ضَلَٰلٍۢ مُّبِينٍۢ","surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf","englishNameTranslation":"The Heights","numberOfAyahs":206,"revelationType":"Meccan"},"numberInSurah":60,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1015,"text":"قَالَ يَٰقَوْمِ لَيْسَ بِى ضَلَٰلَةٌۭ وَلَٰكِنِّى رَسُولٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf","englishNameTranslation":"The Heights","numberOfAyahs":206,"revelationType":"Meccan"},"numberInSurah":61,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1016,"text":"أُبَلِّغُكُمْ رِسَٰلَٰتِ رَبِّى وَأَنصَحُ لَكُمْ وَأَعْلَمُ مِنَ ٱللَّهِ مَا لَا تَعْلَمُونَ","surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf","englishNameTranslation":"The Heights","numberOfAyahs":206,"revelationType":"Meccan"},"numberInSurah":62,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuart