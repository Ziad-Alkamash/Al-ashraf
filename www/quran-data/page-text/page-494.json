{"code":200,"status":"OK","data":{"number":494,"ayahs":[{"number":4386,"text":"وَإِنَّهُۥ لَعِلْمٌۭ لِّلسَّاعَةِ فَلَا تَمْتَرُنَّ بِهَا وَٱتَّبِعُونِ ۚ هَٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":61,"juz":25,"manzil":6,"page":494,"ruku":429,"hizbQuarter":198,"sajda":false},{"number":4387,"text":"وَلَا يَصُدَّنَّكُمُ ٱلشَّيْطَٰنُ ۖ إِنَّهُۥ لَكُمْ عَدُوٌّۭ مُّبِينٌۭ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":62,"juz":25,"manzil":6,"page":494,"ruku":429,"hizbQuarter":198,"sajda":false},{"number":4388,"text":"وَلَمَّا جَآءَ عِيسَىٰ بِٱلْبَيِّنَٰتِ قَالَ قَدْ جِئْتُكُم بِٱلْحِكْمَةِ وَلِأُبَيِّنَ لَكُم بَعْضَ ٱلَّذِى تَخْتَلِفُونَ فِيهِ ۖ فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":63,"juz":25,"manzil":6,"page":494,"ruku":429,"hizbQuarter":198,"sajda":false},{"number":4389,"text":"إِنَّ ٱللَّهَ هُوَ رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ هَٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":64,"juz":25,"manzil":6,"page":494,"ruku":429,"hizbQuarter":198,"sajda":false},{"number":4390,"text":"فَٱخْتَلَفَ ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ فَوَيْلٌۭ لِّلَّذِينَ ظَلَمُوا۟ مِنْ عَذَابِ يَوْمٍ أَلِيمٍ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":65,"juz":25,"manzil":6,"page":494,"ruku":429,"hizbQuarter":198,"sa