{"code":200,"status":"OK","data":{"number":490,"ayahs":[{"number":4336,"text":"وَٱلَّذِى نَزَّلَ مِنَ ٱلسَّمَآءِ مَآءًۢ بِقَدَرٍۢ فَأَنشَرْنَا بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ كَذَٰلِكَ تُخْرَجُونَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":11,"juz":25,"manzil":6,"page":490,"ruku":424,"hizbQuarter":196,"sajda":false},{"number":4337,"text":"وَٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا وَجَعَلَ لَكُم مِّنَ ٱلْفُلْكِ وَٱلْأَنْعَٰمِ مَا تَرْكَبُونَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":12,"juz":25,"manzil":6,"page":490,"ruku":424,"hizbQuarter":196,"sajda":false},{"number":4338,"text":"لِتَسْتَوُۥا۟ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذْكُرُوا۟ نِعْمَةَ رَبِّكُمْ إِذَا ٱسْتَوَيْتُمْ عَلَيْهِ وَتَقُولُوا۟ سُبْحَٰنَ ٱلَّذِى سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقْرِنِينَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":13,"juz":25,"manzil":6,"page":490,"ruku":424,"hizbQuarter":196,"sajda":false},{"number":4339,"text":"وَإِنَّآ إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":14,"juz":25,"manzil":6,"page":490,"ruku":424,"hizbQuarter":196,"sajda":false},{"number":4340,"text":"وَجَعَلُوا۟ لَهُۥ مِنْ عِبَادِهِۦ جُزْءًا ۚ إِنَّ ٱلْإِنسَٰنَ لَكَفُورٌۭ مُّبِينٌ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":15,"juz":25,"manzil":6,"page":490,"ruku":424,"hizbQuarter":196,"sajda":false},{"number":4341,"text":"أَمِ ٱتَّخَذَ مِمَّا يَخْلُقُ بَنَاتٍۢ وَأَصْفَىٰكُم بِٱلْبَنِينَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":16,"juz":25,"manzil":6,"page":490,"ruku":425,"hizbQuarter":196,"sajda":false},{"number":4342,"text":"وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحْمَٰنِ مَثَلًۭا ظَلَّ وَجْهُهُۥ مُسْوَدًّۭا وَهُوَ كَظِيمٌ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":17,"juz":25,"manzil":6,"page":490,"ruku":425,"hizbQuarter":196,"sajda":false},{"number":4343,"text":"أَوَمَن يُنَشَّؤُا۟ فِى ٱلْحِلْيَةِ وَهُوَ فِى ٱلْخِصَامِ غَيْرُ مُبِينٍۢ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":18,"juz":25,"manzil":6,"page":490,"ruku":425,"hizbQuarter":196,"sajda":false},{"number":4344,"text":"وَجَعَلُوا۟ ٱلْمَلَٰٓئِكَةَ ٱلَّذِينَ هُمْ عِبَٰدُ ٱلرَّحْمَٰنِ إِنَٰثًا ۚ أَشَهِدُوا۟ خَلْقَهُمْ ۚ سَتُكْتَبُ شَهَٰدَتُهُمْ وَيُسْـَٔلُونَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":19,"juz":25,"manzil":6,"page":490,"ruku":425,"hizbQuarter":196,"sajda":false},{"number":4345,"text":"وَقَالُوا۟ لَوْ شَآءَ ٱلرَّحْمَٰنُ مَا عَبَدْنَٰهُم ۗ مَّا لَهُم بِذَٰلِكَ مِنْ عِلْمٍ ۖ إِنْ هُمْ إِلَّا يَخْرُصُونَ","surah":{"number":43,"name":"سُورَةُ الزُّخۡرُفِ","englishName":"Az-Zukhruf","englishNameTranslation":"Ornaments of gold","numberOfAyahs":89,"revelationType":"Meccan"},"numberInSurah":20,"juz":25,"manzil":6,"page":490,"ruku":425,"hizbQuarter":196,"sajda":false},{"number":4346,"text":"أَمْ ءَاتَيْنَٰهُمْ كِتَٰبًۭا مِّن ق