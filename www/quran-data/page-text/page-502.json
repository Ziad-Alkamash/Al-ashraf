{"code":200,"status":"OK","data":{"number":502,"ayahs":[{"number":4506,"text":"وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","surah":{"number":45,"name":"سُورَةُ الجَاثِيَةِ","englishName":"Al-Jaathiya","englishNameTranslation":"Crouching","numberOfAyahs":37,"revelationType":"Meccan"},"numberInSurah":33,"juz":25,"manzil":6,"page":502,"ruku":437,"hizbQuarter":200,"sajda":false},{"number":4507,"text":"وَقِيلَ ٱلْيَوْمَ نَنسَىٰكُمْ كَمَا نَسِيتُمْ لِقَآءَ يَوْمِكُمْ هَٰذَا وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّٰصِرِينَ","surah":{"number":45,"name":"سُورَةُ الجَاثِيَةِ","englishName":"Al-Jaathiya","englishNameTranslation":"Crouching","numberOfAyahs":37,"revelationType":"Meccan"},"numberInSurah":34,"juz":25,"manzil":6,"page":502,"ruku":437,"hizbQuarter":200,"sajda":false},{"number":4508,"text":"ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَٰتِ ٱللَّهِ هُزُوًۭا وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ","surah":{"number":45,"name":"سُورَةُ الجَاثِيَةِ","englishName":"Al-Jaathiya","englishNameTranslation":"Crouching","numberOfAyahs":37,"revelationType":"Meccan"},"numberInSurah":35,"juz":25,"manzil":6,"page":502,"ruku":437,"hizbQuarter":200,"sajda":false},{"number":4509,"text":"فَلِلَّهِ ٱلْحَمْدُ رَبِّ ٱلسَّمَٰوَٰتِ وَرَبِّ ٱلْأَرْضِ رَبِّ ٱلْعَٰلَمِينَ","surah":{"number":45,"name":"سُورَةُ الجَاثِيَةِ","englishName":"Al-Jaathiya","englishNameTranslation":"Crouching","numberOfAyahs":37,"revelationType":"Meccan"},"numberInSurah":36,"juz":25,"manzil":6,"page":502,"ruku":437,"hizbQuarter":200,"sajda":false},{"number":4510,"text":"وَلَهُ ٱلْكِبْرِيَآءُ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","surah":{"number":45,"name":"سُورَةُ الجَاثِيَةِ","englishName":"Al-Jaathiya","englishNameTranslation":"Crouching","numberOfAyahs":37,"revelationType":"Meccan"},"numberInSurah":37,"juz":25,"manzil":6,"page":502,"ruku":437,"hizbQuarter":200,"sajda":false},{"number":4511,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ","surah":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Al-Ahqaf","englishNameTranslation":"The Dunes","numberOfAyahs":35,"revelationType":"Meccan"},"numberInSurah":1,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4512,"text":"تَنزِيلُ ٱلْكِتَٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ","surah":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Al-Ahqaf","englishNameTranslation":"The Dunes","numberOfAyahs":35,"revelationType":"Meccan"},"numberInSurah":2,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4513,"text":"مَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ وَأَجَلٍۢ مُّسَمًّۭى ۚ وَٱلَّذِينَ كَفَرُوا۟ عَمَّآ أُنذِرُوا۟ مُعْرِضُونَ","surah":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Al-Ahqaf","englishNameTranslation":"The Dunes","numberOfAyahs":35,"revelationType":"Meccan"},"numberInSurah":3,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4514,"text":"قُلْ أَرَءَيْتُم مَّا تَدْعُونَ مِن دُونِ ٱللَّهِ أَرُونِى مَاذَا خَلَقُوا۟ مِنَ ٱلْأَرْضِ أَمْ لَهُمْ شِرْكٌۭ فِى ٱلسَّمَٰوَٰتِ ۖ ٱئْتُونِى بِكِتَٰبٍۢ مِّن قَبْلِ هَٰذَآ أَوْ أَثَٰرَةٍۢ مِّنْ عِلْمٍ إِن كُنتُمْ صَٰدِقِينَ","surah":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Al-Ahqaf","englishNameTranslation":"The Dunes","numberOfAyahs":35,"revelationType":"Meccan"},"numberInSurah":4,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4515,"text":"وَمَنْ أَضَلُّ مِمَّن يَدْعُوا۟ مِن دُونِ ٱللَّهِ مَن لَّا يَسْتَجِيبُ لَهُۥٓ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ وَهُمْ عَن دُعَآئِهِمْ غَٰفِلُونَ","surah":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Al-Ahqaf","englishNameTranslation":"The Dunes","numberOfAyahs":35,"revelationType":"Meccan"},"numberInSurah":5,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false}],"surahs":{"45":{"