<?xml version="1.0" encoding="utf-8"?>
<!-- Preview-only: عيّنة ثابتة تتعرض في قائمة اختيار الويدجت بس -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tasbih_preview_chip"
        android:paddingBottom="4dp"
        android:paddingEnd="14dp"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:text="سبحان الله"
        android:textColor="#6B5212"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/tasbih_preview_disc"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tasbih_preview_inner"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9"
                android:textColor="#211F1A"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/tasbih_preview_pill"
                android:paddingBottom="3dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="3dp"
                android:text="من 33"
                android:textColor="#6B5212"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
