<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- خلفية الويدجت (لون/شفافية/وضع فاتح أو داكن) بتترسم برمجيًا حسب حجم الويدجت الفعلي -->
    <ImageView
        android:id="@+id/widget_prayer_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- layoutDirection=rtl ثابت بغض النظر عن لغة النظام (نفس ترتيب صفحة مواقيت الصلاة في التطبيق) -->
    <LinearLayout
        android:id="@+id/widget_prayer_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_prayer_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:contentDescription="@null" />

        <!-- هيرو الصلاة القادمة: في منتصف الويدجت، مميّز بخلفية وإطار زيتوني، وتحته العدّاد مباشرة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/widget_prayer_hero_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:minWidth="150dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/widget_prayer_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- كبسولة العدّاد: أيقونة ساعة + Chronometer حي، مركزية تحت الهيرو مباشرة
                 (الاستثناء الوحيد اللي بيفضل TextView حقيقي لأنه بيتحدّث لحظيًا من النظام) -->
            <LinearLayout
                android:id="@+id/widget_prayer_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:gravity="center_vertical"
                android:background="@drawable/widget_wp_pill_light"
                android:paddingLeft="10dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/widget_prayer_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />

                <Chronometer
                    android:id="@+id/widget_prayer_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:gravity="center"
                    android:textColor="#6F7752"
                    android:textSize="13sp"
                    android:fontFamily="@font/tajawal_bold"
                    android:format="%s" />
            </LinearLayout>

            <!-- الشروق: أيقونة + الاسم + الوقت، مركزية وصغيرة تحت العدّاد -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_sunrise_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_sunrise_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_sunrise_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- كارت الصلوات الخمس: نفس شكل صفحة المواقيت (٥ أعمدة: أيقونة + اسم + وقت)،
             والفرض القادم مميّز بخلفية وإطار زيتوني -->
        <LinearLayout
            android:id="@+id/widget_prayer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="5"
            android:background="@drawable/widget_wp_card_light"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/widget_card_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">
                <ImageView
                    android:id="@+id/widget_prayer_fajr_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_fajr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_fajr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_card_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">
                <ImageView
                    android:id="@+id/widget_prayer_dhuhr_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_dhuhr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_dhuhr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_card_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">
                <ImageView
                    android:id="@+id/widget_prayer_asr_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_asr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_asr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_card_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">
                <ImageView
                    android:id="@+id/widget_prayer_maghrib_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_maghrib_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_maghrib_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_card_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="4dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp">
                <ImageView
                    android:id="@+id/widget_prayer_isha_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_isha_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_prayer_isha_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>

        <!-- صف التواريخ تحت مواقيت الصلاة: الهجري يمين، اسم اليوم في المنتصف، الميلادي يسار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_day_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_gregorian_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
