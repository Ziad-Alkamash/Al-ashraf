<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة إعدادات الويدجت بطابع صفحة "الصوتيات": كريمي #FAF8F3 + زيتوني #6F7752 + ذهبي -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#FAF8F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#B8892B"
            android:textSize="13sp"
            android:fontFamily="@font/tajawal_medium"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="إعدادات الويدجت"
            android:textColor="#211F1A"
            android:textSize="20sp"
            android:fontFamily="@font/tajawal_bold"
            android:gravity="center" />

        <!-- وضع الويدجت: فاتح / داكن -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شكل الويدجت"
            android:textColor="#211F1A"
            android:textSize="15sp"
            android:fontFamily="@font/tajawal_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="اختر وضع فاتح (كريمي) أو داكن"
            android:textColor="#8E8A7D"
            android:textSize="12sp"
            android:fontFamily="@font/tajawal_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/config_theme_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/config_seg_on"
                android:gravity="center"
                android:padding="12dp"
                android:text="فاتح"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/tajawal_bold" />

            <TextView
                android:id="@+id/config_theme_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/config_seg_off"
                android:gravity="center"
                android:padding="12dp"
                android:text="داكن"
                android:textColor="#5A574D"
                android:textSize="15sp"
                android:fontFamily="@font/tajawal_bold" />
        </LinearLayout>

        <!-- درجة الشفافية -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="درجة شفافية خلفية الويدجت"
            android:textColor="#211F1A"
            android:textSize="15sp"
            android:fontFamily="@font/tajawal_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="٠٪ خلفية شفافة تمامًا، و١٠٠٪ خلفية معتمة بالكامل"
            android:textColor="#8E8A7D"
            android:textSize="12sp"
            android:fontFamily="@font/tajawal_medium" />

        <SeekBar
            android:id="@+id/config_transparency_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="#6F7752"
            android:thumbTint="#6F7752"
            android:progressBackgroundTint="#E7E5D8" />

        <TextView
            android:id="@+id/config_transparency_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="100% معتم"
            android:textColor="#6F7752"
            android:textSize="14sp"
            android:fontFamily="@font/tajawal_bold" />

        <!-- لون الخط: يختاره المستخدم بنفسه ليتوافق مع خلفيته -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لون الخط"
            android:textColor="#211F1A"
            android:textSize="15sp"
            android:fontFamily="@font/tajawal_medium" />

        <TextView
            android:id="@+id/config_font_color_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="اختر لون الخط اللي يناسب خلفيتك"
            android:textColor="#8E8A7D"
            android:textSize="12sp"
            android:fontFamily="@font/tajawal_medium" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/config_font_color_swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/config_font_color_preview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp" />

            <EditText
                android:id="@+id/config_font_color_hex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="#RRGGBB"
                android:inputType="textCapCharacters"
                android:maxLength="7"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#211F1A"
                android:textColorHint="#8E8A7D"
                android:textSize="14sp"
                android:fontFamily="@font/tajawal_medium"
                android:background="@null" />

            <TextView
                android:id="@+id/config_font_color_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تلقائي"
                android:textColor="#B8892B"
                android:textSize="13sp"
                android:fontFamily="@font/tajawal_bold"
                android:padding="8dp" />
        </LinearLayout>

        <!-- إضافة ذكر مخصص لويدجت المسبحة فقط -->
        <LinearLayout
            android:id="@+id/config_tasbih_dhikr_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أذكارك الخاصة"
                android:textColor="#211F1A"
                android:textSize="15sp"
                android:fontFamily="@font/tajawal_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="أضف ذكرًا من اختيارك ليظهر ضمن الأذكار المتاحة في الويدجت."
                android:textColor="#8E8A7D"
                android:textSize="12sp"
                android:fontFamily="@font/tajawal_medium" />

            <EditText
                android:id="@+id/config_tasbih_dhikr_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/config_seg_off"
                android:hint="اكتب الذكر هنا"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="120"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#211F1A"
                android:textColorHint="#8E8A7D"
                android:textSize="14sp"
                android:fontFamily="@font/tajawal_medium" />

            <Button
                android:id="@+id/config_tasbih_dhikr_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="إضافة الذكر"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/tajawal_bold"
                android:backgroundTint="#6F7752" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/config_seg_off"
                android:padding="10dp"
                android:text="معلومة: اضغط على اسم الذكر في الويدجت للانتقال إلى الذكر التالي."
                android:textColor="#6F7752"
                android:textSize="12sp"
                android:fontFamily="@font/tajawal_medium" />
        </LinearLayout>

        <!-- فترة تبديل الدعاء: تظهر فقط لويدجت الدعاء -->
        <LinearLayout
            android:id="@+id/config_interval_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="كل كام دقيقة يتغيّر الدعاء؟"
                android:textColor="#211F1A"
                android:textSize="15sp"
                android:fontFamily="@font/tajawal_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="اختر الفترة اللي تناسبك، من ٥ دقايق لحد ٣ ساعات"
                android:textColor="#8E8A7D"
                android:textSize="12sp"
                android:fontFamily="@font/tajawal_medium" />

            <SeekBar
                android:id="@+id/config_interval_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#6F7752"
                android:thumbTint="#6F7752"
                android:progressBackgroundTint="#E7E5D8" />

            <TextView
                android:id="@+id/config_interval_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="كل ٣٠ دقيقة"
                android:textColor="#6F7752"
                android:textSize="14sp"
                android:fontFamily="@font/tajawal_bold" />

        </LinearLayout>

        <Button
            android:id="@+id/config_save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الإعدادات"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/tajawal_bold"
            android:backgroundTint="#6F7752"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
