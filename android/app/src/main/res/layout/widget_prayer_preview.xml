<?xml version="1.0" encoding="utf-8"?>
<!-- Preview-only layout: عيّنة ثابتة تتعرض في قائمة اختيار الويدجت (widget picker) بس.
     مفيش أي IDs بتتعمل لها findViewById في الكود — دي مجرد "صورة توضيحية" حية،
     عشان المستخدم يشوف شكل الويدجت الحقيقي قبل ما يضيفه، بدل مربع فاضي. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="#F5F1E6"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:textColor="#6F7752"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="العصر"
            android:textColor="#3B3B2E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="٣:٤٥ م"
            android:textColor="#3B3B2E"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E7E1CE"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⏱ ٠١:١٢:٣٠"
            android:textColor="#6F7752"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="#E7E1CE"
        android:padding="4dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="الفجر\n٤:١٢" android:textSize="9sp" android:textColor="#3B3B2E" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="الظهر\n١٢:٠٥" android:textSize="9sp" android:textColor="#3B3B2E" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="العصر\n٣:٤٥" android:textSize="9sp" android:textColor="#6F7752" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="المغرب\n٦:١٠" android:textSize="9sp" android:textColor="#3B3B2E" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="العشاء\n٧:٣٠" android:textSize="9sp" android:textColor="#3B3B2E" />
    </LinearLayout>

</LinearLayout>
