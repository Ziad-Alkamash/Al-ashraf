<?xml version="1.0" encoding="utf-8"?>
<!-- Preview-only layout: عيّنة ثابتة تتعرض في قائمة اختيار الويدجت (widget picker) بس. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#F5F1E6"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="المصحف الأشرف"
        android:textColor="#6F7752"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ"
        android:textColor="#3B3B2E"
        android:textSize="15sp" />

</LinearLayout>
