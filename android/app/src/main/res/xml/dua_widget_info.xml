<?xml version="1.0" encoding="utf-8"?>
<!-- الحجم الافتراضي عند الإضافة بقى ٤×٣ (بدل الصغير القديم) عشان الدعاء يبان واضح؛
     minResize* بيسمح للمستخدم يصغّرها بإيده لو حب -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="200dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_dua"
    android:previewLayout="@layout/widget_dua_preview"
    android:label="@string/widget_dua_label"
    android:description="@string/widget_dua_description"
    android:configure="com.ashraf.mushaf.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
